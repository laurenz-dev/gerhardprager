# --- Sprach-Startseiten / restliche alte URLs pro Sprache ---
/index.php/de/*                    /               301
/index.php/en/*                    /en/            301
/index.php/ar/*                    /ar/            301
/index.php/ru/*                    /               301

# --- Auffangregel: ALLES uebrige unter /index.php/ ---
/index.php/*                       /               301
/index.php                         /               301

