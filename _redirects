# =========================================================
#  HOST-KANONISIERUNG: non-www -> www (301)
#  (Beide Domains haengen am selben Cloudflare-Pages-Projekt.
#   Alternative: Cloudflare Bulk Redirect Rule auf Zone-Ebene.)
# =========================================================
https://gerhardprager.eu/* https://www.gerhardprager.eu/:splat 301

# Alte englische Datei-Slugs -> neue deutsche clean URLs (301)
/procedures     /eingriffe       301
/about          /ueber-mich      301
/science        /wissenschaft    301
/press          /presse          301
/contact        /kontakt         301

# =========================================================
#  ALTE JOOMLA-URLS (/index.php/...) -> neue Seiten
#  301 = permanent. Loest Duplikate + 5xx-Fehler auf einen Schlag
#  und vererbt die Autoritaet der alten Seite an die neue.
#  Reihenfolge: spezifisch -> allgemein (erste Treffer-Regel gewinnt)
# =========================================================

# --- Deutsch: praezise Zuordnung (Zielseiten sicher vorhanden) ---
/index.php/de/person*              /ueber-mich     301
/index.php/de/leistungen*          /eingriffe      301
/index.php/de/publikationen*       /wissenschaft   301
/index.php/de/kontakt-anfahrt*     /kontakt        301

# --- Englisch: praezise Zuordnung (en/-Zielseiten verifiziert vorhanden) ---
